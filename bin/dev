#!/usr/bin/env bash
# Local development: esbuild watch, Daphne (HTTP + WebSockets) and one worker.
set -euo pipefail
cd "$(dirname "$0")/.."
export DJANGO_DEBUG=1

trap 'kill 0' EXIT INT TERM
npm run watch &
uv run python manage.py steady_queue &
uv run daphne -b 127.0.0.1 -p "${PORT:-8000}" config.asgi:application &
wait
