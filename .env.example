# Copy to .env for local production-like runs; Coolify sets these in its UI.
DJANGO_SECRET_KEY=change-me-to-50-random-characters
DJANGO_ENV=production
DJANGO_ALLOWED_HOSTS=kanban.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://kanban.example.com
KANBAN_BASE_URL=https://kanban.example.com
KANBAN_DATA_DIR=/data
KANBAN_MEDIA_DIR=/media
DJANGO_DEFAULT_FROM_EMAIL=Kanban.fun <hello@example.com>
DJANGO_EMAIL_HOST=smtp.example.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
# python manage.py generate_vapid_keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@example.com
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
